<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="run.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!--
          Signature assets live in physical public/email but are published at
          /email/*. Serve them straight from disk so Outlook's image proxy gets
          a plain static response (never the Node catch-all / SPA HTML).
        -->
        <rule name="EmailStatic" stopProcessing="true">
          <match url="^email/(.*)$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}public\email\{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="public/email/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="StaticContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="run.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode node_env="production" />
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <staticContent>
      <!-- Register the signature formats explicitly (remove first to avoid a
           duplicate-mapping 500.19 on IIS installs that already define them). -->
      <remove fileExtension=".gif" />
      <mimeMap fileExtension=".gif" mimeType="image/gif" />
      <remove fileExtension=".png" />
      <mimeMap fileExtension=".png" mimeType="image/png" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
  <!--
    The /email URL is rewritten to public/email above. Client caching is keyed
    on the requested URL path, so this location (not only the physical folder)
    carries the 30-day cache. Bump ASSET_VERSION in src/lib/signatureConfig.ts
    to publish a new folder instead of editing cached files in place.
  -->
  <location path="email">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Defense-in-depth if the physical folder is ever mapped directly. -->
  <location path="public/email">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
