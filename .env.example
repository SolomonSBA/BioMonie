# =============================================================================
# BIOMONIE ENVIRONMENT VARIABLES
# =============================================================================

# 1. Canonical Site Origin
# Controls the base URL for email signature assets, banner download links,
# website hrefs in signatures, and the /download QR code.
#
# Production (default when left unset):
# VITE_SITE_ORIGIN=https://biomonie.com
#
# Render Staging:
# Set this in the Render dashboard (Environment Variables) for https://biomonie1.onrender.com
# DO NOT commit a .env file with the staging value to Git.
# VITE_SITE_ORIGIN=https://biomonie1.onrender.com

# 2. Contact Form API Endpoint
# Leave unset for same-origin when the app and API are served from one host.
VITE_CONTACT_API_URL=
